{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,

    /* ⬇ Turn off unused-variable errors */
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src"]
}
